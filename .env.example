# =============================================================================
# Pengaturan SERVER (Node.js). Di cPanel: isi di Setup Node.js App →
# Environment variables (atau file .env di folder aplikasi, chmod 600).
# File .env TIDAK boleh di-commit. Tidak ada yang berawalan VITE_ di sini:
# isi file ini tidak pernah dikirim ke browser.
# =============================================================================
NODE_ENV=production
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Client ID OAuth Google (Web application). Bukan rahasia; client secret tidak dipakai.
GOOGLE_CLIENT_ID=
# Folder berkas PDF peserta, HARUS di luar public_html.
UPLOAD_DIR=/home/pribadisch/beasiswa-data/berkas
# Hanya untuk uji di komputer (ditolak bila NODE_ENV=production):
# ALLOW_DEV_LOGIN=1
