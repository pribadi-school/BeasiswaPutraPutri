{
  "name": "beasiswa-putra-putri-daerah",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Pendaftaran Beasiswa Putra-Putri Daerah SMP–SMA Pribadi Depok (React + Node.js + MySQL)",
  "scripts": {
    "dev": "vite",
    "dev:server": "VITE_BACKEND=server vite",
    "server": "node --env-file-if-exists=.env server/index.ts",
    "build": "tsc -p tsconfig.json && vite build && tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json --noEmit",
    "package": "node scripts/package.ts",
    "admin:set": "node --env-file-if-exists=.env server/admin-cli.ts set",
    "admin:remove": "node --env-file-if-exists=.env server/admin-cli.ts remove",
    "admin:list": "node --env-file-if-exists=.env server/admin-cli.ts list",
    "test": "vitest run",
    "test:server": "vitest run tests/server",
    "local": "node scripts/local-stack.ts",
    "deploy": "node scripts/publish-deploy.ts",
    "notify": "node --env-file-if-exists=.env server/notify-cli.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.5",
    "express": "^4.22.3",
    "jose": "^6.2.17",
    "lucide-react": "^1.52.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
